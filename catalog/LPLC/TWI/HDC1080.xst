<?xml version='1.0' encoding='utf-8' standalone='yes'?>
<xst path='/$YS/TYPES/LPLC/TWI'>
  <i n='HDC1080' m='{"attr":69}' ver='0.5.2610.30001' s='{
	"hint": "Low Power, High Accuracy Digital Humidity Sensor with Temperature Sensor",
	"icon": "data:image/svg+xml;base64,",
	"willful": true,
	"LPLC": {
	  "args": ["TwiNr", "Address", "Period"],
	  "in": [],
	  "src": "class HDC1080 {\n  constructor(TwiNr, Address, Period) {\n    this.Bus = TwiNr;\n    this.Address = Address;\n    this.Interval = Int32(Period);\n    this.T = new Float(0);\n    this.H = new Float(0);\n    this.Valid = false;\n    this.Status = new Int32(0);\n    this.Phase = new Int32(0);\n    this.Waiting = false;\n    this.Count = new Int32(0);\n    this.At = new Int32(0);\n    this.CycleAt = new Int32(0);\n    this.Pause = new Int32(20);\n    this.At = getMilliseconds();\n  }\n  Tick() {\n    let now = getMilliseconds();\n    let status = 0, count = 0, error = -3, i = 0;\n    if(this.Waiting) {\n      status = TwiBusStatus(this.Bus);\n      if(status == 0) { this.Fail(-3, now); return; }\n      if((status &amp; 0xF000) == 0) return;\n      this.Waiting = false;\n      count = (status &gt;&gt;&gt; 24) &amp; 255;\n      if((status &amp; 0xF000) != 0x1000) {\n        if(status &amp; 0x4000) error = -1;\n        else if(status &amp; 0x2000) error = -2;\n        this.Fail(error, now);\n        return;\n      }\n      if((status &amp; 255) != this.Address || count != this.Count) {\n        while(i &lt; count &amp;&amp; i &lt; 32) { TwiBusGetByte(this.Bus); i++; }\n        this.Fail(-3, now);\n        return;\n      }\n      this.Complete(now);\n      return;\n    }\n    if(((now - this.At) | 0) &lt; this.Pause) return;\n    if(TwiBusStatus(this.Bus) != 0) return;\n    if(this.Phase == 0) this.ReadRegister(0xFE);\n    else if(this.Phase == 1) this.ReadRegister(0xFF);\n    else if(this.Phase == 2) {\n      this.Count = 0;\n      TwiBusControl(this.Bus, this.Address | 0x00030100);\n      TwiBusPutByte(this.Bus, 2);\n      TwiBusPutByte(this.Bus, 0x10);\n      TwiBusPutByte(this.Bus, 0);\n      this.Waiting = true;\n    } else if(this.Phase == 3) this.ReadRegister(2);\n    else if(this.Phase == 4) {\n      this.CycleAt = now;\n      this.Count = 0;\n      TwiBusControl(this.Bus, this.Address | 0x00010100);\n      TwiBusPutByte(this.Bus, 0);\n      this.Waiting = true;\n    } else if(this.Phase == 5) {\n      this.Count = 4;\n      TwiBusControl(this.Bus, this.Address | 0x04000200);\n      this.Waiting = true;\n    }\n  }\n  ReadRegister(reg) {\n    this.Count = 2;\n    TwiBusControl(this.Bus, this.Address | 0x02010300);\n    TwiBusPutByte(this.Bus, reg);\n    this.Waiting = true;\n  }\n  Word() {\n    let hi = TwiBusGetByte(this.Bus);\n    let lo = TwiBusGetByte(this.Bus);\n    return (hi &lt;&lt; 8) | lo;\n  }\n  Complete(now) {\n    this.At = now;\n    this.Pause = 0;\n    if(this.Phase == 0) {\n      if(this.Word() != 0x5449) { this.Fail(-4, now); return; }\n      this.Phase = 1;\n    } else if(this.Phase == 1) {\n      if(this.Word() != 0x1050) { this.Fail(-4, now); return; }\n      this.Phase = 2;\n    } else if(this.Phase == 2) this.Phase = 3;\n    else if(this.Phase == 3) {\n      if((this.Word() &amp; 0xF7FF) != 0x1000) { this.Fail(-5, now); return; }\n      this.Phase = 4;\n    } else if(this.Phase == 4) {\n      this.Phase = 5;\n      this.Pause = 20;\n    } else if(this.Phase == 5) {\n      let rawT = this.Word();\n      let rawH = this.Word();\n      if(((rawT | rawH) &amp; 3) != 0) { this.Fail(-7, now); return; }\n      let temperature = Float(rawT) * 165 / 65536 - 40;\n      let humidity = Float(rawH) * 100 / 65536;\n      this.T = temperature;\n      this.H = humidity;\n      this.Valid = true;\n      this.SetStatus(1);\n      this.Phase = 4;\n      this.Pause = this.Interval - ((now - this.CycleAt) | 0);\n      if(this.Pause &lt; 0) this.Pause = 0;\n    }\n  }\n  Fail(code, now) {\n    this.Valid = false;\n    this.Waiting = false;\n    this.Phase = 0;\n    this.At = now;\n    this.Pause = 1000;\n    this.SetStatus(code);\n  }\n  SetStatus(code) {\n    if(this.Status == code) return;\n    this.Status = code;\n    let stream = LOG_INFO;\n    if(code &lt; 0) stream = LOG_WARN;\n    SendByte(stream, 72) &amp;&amp; SendByte(stream, 68) &amp;&amp; SendByte(stream, 67) &amp;&amp; SendByte(stream, 49) &amp;&amp; SendByte(stream, 48) &amp;&amp; SendByte(stream, 56) &amp;&amp; SendByte(stream, 48) &amp;&amp; SendByte(stream, 32) &amp;&amp; PrintInt32(stream, this.Bus) &amp;&amp; SendByte(stream, 47) &amp;&amp; PrintInt32(stream, this.Address) &amp;&amp; SendByte(stream, 58) &amp;&amp; PrintInt32(stream, code);\n    SendByte(stream, 0);\n  }\n}"
	},
	"manifest": { "type": "LPLC/TWI/HDC1080", "MQTT-SN": { "tag": "---" }, "LPLC": {
	  "pos": { "top": 0, "left": 0 }, "args": { "TwiNr": 0, "Address": 64, "Period": 1000 },
	  "in": {}, "out": { "T": true, "H": true, "Valid": true }, "run": {}
	} },
	"mi": { "LPLC": { "mi": {
	  "args": { "mi": {
		"TwiNr": { "cdr": 1, "label": "TWI", "editor": "Integer", "default": 0, "choices": { "provider": "bus", "kind": "twi", "scope": "configured" } },
		"Address": { "cdr": 2, "label": "Address", "editor": "Integer", "format": "0x{0:X2}", "default": 64, "choices": { "provider": "list", "values": [64] } },
		"Period": { "cdr": 3, "label": "Period", "editor": "Integer", "format": "{0} ms", "default": 3000, "choices": { "provider": "list", "values": [3000, 300000] } }
	  } },
	  "in": { "mi": {} },
	  "out": { "mi": {
		"T": { "default": true, "hint": "Temperature in Celsius" },
		"H": { "default": true, "hint": "Relative humidity in percent" },
		"Valid": { "default": true, "hint": "False at startup and after an error; true after a good sample, retained while measuring" },
		"Status": { "default": true, "hint": "0 initializing; 1 good sample; -1 NACK (also conversion not ready); -2 TWI timeout; -3 bus/protocol error; -4 unsupported manufacturer/device ID; -5 configuration mismatch; -7 invalid sample. Errors retry initialization after 1 s" }
	  } }
	} } }
  }' />
</xst>
