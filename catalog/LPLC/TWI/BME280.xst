<?xml version='1.0' encoding='utf-8' standalone='yes'?>
<xst path='/$YS/TYPES/LPLC/TWI'>
  <i n='BME280' m='{"attr":69}' ver='0.5.2610.30003' s='{
	"hint": "Temperature, Humidity and Pressure Sensor",
	"icon": "data:image/svg+xml;base64,",
	"willful": true,
	"LPLC": {
	  "args": ["TwiNr", "Address", "Period"],
	  "in": [],
	  "src": "class BME280 {\n  constructor(TwiNr, Address, Period) {\n    this.Bus = TwiNr;\n    this.Address = Address;\n    this.Interval = Int32(Period);\n    this.T = new Float(0);\n    this.P = new Float(0);\n    this.H = new Float(-1);\n    this.Valid = false;\n    this.Status = new Int32(0);\n    this.Chip = new Int32(0);\n    this.Phase = new Int32(0);\n    this.Waiting = false;\n    this.Count = new Int32(0);\n    this.At = new Int32(0);\n    this.PhaseAt = new Int32(0);\n    this.CycleAt = new Int32(0);\n    this.Pause = new Int32(10);\n    this.At = getMilliseconds();\n    this.T1 = new Int32(0); this.T2 = new Int32(0); this.T3 = new Int32(0);\n    this.P1 = new Int32(0); this.P2 = new Int32(0); this.P3 = new Int32(0);\n    this.P4 = new Int32(0); this.P5 = new Int32(0); this.P6 = new Int32(0);\n    this.P7 = new Int32(0); this.P8 = new Int32(0); this.P9 = new Int32(0);\n    this.H1 = new Int32(0); this.H2 = new Int32(0); this.H3 = new Int32(0);\n    this.H4 = new Int32(0); this.H5 = new Int32(0); this.H6 = new Int32(0);\n  }\n  Tick() {\n    let now = getMilliseconds();\n    let status = 0, count = 0, error = -3, i = 0;\n    if(this.Waiting) {\n      status = TwiBusStatus(this.Bus);\n      if(status == 0) { this.Fail(-3, now); return; }\n      if((status &amp; 0xF000) == 0) return;\n      this.Waiting = false;\n      count = (status &gt;&gt;&gt; 24) &amp; 255;\n      if((status &amp; 0xF000) != 0x1000) {\n        if(status &amp; 0x4000) error = -1;\n        else if(status &amp; 0x2000) error = -2;\n        this.Fail(error, now);\n        return;\n      }\n      if((status &amp; 255) != this.Address || count != this.Count) {\n        while(i &lt; count &amp;&amp; i &lt; 32) { TwiBusGetByte(this.Bus); i++; }\n        this.Fail(-3, now);\n        return;\n      }\n      this.Complete(now);\n      return;\n    }\n    if(((now - this.At) | 0) &lt; this.Pause) return;\n    if((this.Phase == 2 || this.Phase == 8) &amp;&amp; ((now - this.PhaseAt) | 0) &gt;= 200) {\n      this.Fail(-6, now);\n      return;\n    }\n    if(TwiBusStatus(this.Bus) != 0) return;\n    if(this.Phase == 0) this.Read(0xD0, 1);\n    else if(this.Phase == 1) this.Write(0xE0, 0xB6);\n    else if(this.Phase == 2 || this.Phase == 8) this.Read(0xF3, 1);\n    else if(this.Phase == 3) this.Read(0x88, this.Chip == 0x60 ? 26 : 24);\n    else if(this.Phase == 4) this.Read(0xE1, 7);\n    else if(this.Phase == 5) this.Write(0xF2, 1);\n    else if(this.Phase == 6) this.Write(0xF5, 0);\n    else if(this.Phase == 7) { this.CycleAt = now; this.Write(0xF4, 0x25); }\n    else if(this.Phase == 9) this.Read(0xF7, this.Chip == 0x60 ? 8 : 6);\n  }\n  Read(reg, count) {\n    this.Count = count;\n    TwiBusControl(this.Bus, this.Address | 0x00010300 | (count &lt;&lt; 24));\n    TwiBusPutByte(this.Bus, reg);\n    this.Waiting = true;\n  }\n  Write(reg, value) {\n    this.Count = 0;\n    TwiBusControl(this.Bus, this.Address | 0x00020100);\n    TwiBusPutByte(this.Bus, reg);\n    TwiBusPutByte(this.Bus, value);\n    this.Waiting = true;\n  }\n  U16() {\n    let lo = TwiBusGetByte(this.Bus);\n    let hi = TwiBusGetByte(this.Bus);\n    return lo | (hi &lt;&lt; 8);\n  }\n  S16() {\n    let value = this.U16();\n    return (value &lt;&lt; 16) &gt;&gt; 16;\n  }\n  Raw20() {\n    let hi = TwiBusGetByte(this.Bus);\n    let lo = TwiBusGetByte(this.Bus);\n    let fraction = TwiBusGetByte(this.Bus);\n    return (hi &lt;&lt; 12) | (lo &lt;&lt; 4) | (fraction &gt;&gt; 4);\n  }\n  Complete(now) {\n    let flags = 0, e4 = 0, e5 = 0, e6 = 0, e7 = 0, rawP = 0, rawT = 0, rawH = 0, hi = 0;\n    this.At = now;\n    this.Pause = 0;\n    if(this.Phase == 0) {\n      this.Chip = TwiBusGetByte(this.Bus);\n      if(this.Chip != 0x60 &amp;&amp; this.Chip != 0x58) { this.Fail(-4, now); return; }\n      this.Phase = 1;\n    } else if(this.Phase == 1) {\n      this.Phase = 2; this.PhaseAt = now; this.Pause = 10;\n    } else if(this.Phase == 2) {\n      flags = TwiBusGetByte(this.Bus);\n      if(flags &amp; 1) this.Pause = 10;\n      else this.Phase = 3;\n    } else if(this.Phase == 3) {\n      this.T1 = this.U16(); this.T2 = this.S16(); this.T3 = this.S16();\n      this.P1 = this.U16(); this.P2 = this.S16(); this.P3 = this.S16();\n      this.P4 = this.S16(); this.P5 = this.S16(); this.P6 = this.S16();\n      this.P7 = this.S16(); this.P8 = this.S16(); this.P9 = this.S16();\n      if(this.Chip == 0x60) { TwiBusGetByte(this.Bus); this.H1 = TwiBusGetByte(this.Bus); }\n      if(this.T1 == 0 || this.T1 == 65535 || this.P1 == 0 || this.P1 == 65535) { this.Fail(-5, now); return; }\n      this.Phase = this.Chip == 0x60 ? 4 : 6;\n    } else if(this.Phase == 4) {\n      this.H2 = this.S16();\n      this.H3 = TwiBusGetByte(this.Bus);\n      e4 = TwiBusGetByte(this.Bus);\n      e5 = TwiBusGetByte(this.Bus);\n      e6 = TwiBusGetByte(this.Bus);\n      e7 = TwiBusGetByte(this.Bus);\n      this.H4 = ((e4 &lt;&lt; 24) &gt;&gt; 20) | (e5 &amp; 15);\n      this.H5 = ((e6 &lt;&lt; 24) &gt;&gt; 20) | (e5 &gt;&gt; 4);\n      this.H6 = (e7 &lt;&lt; 24) &gt;&gt; 24;\n      this.Phase = 5;\n    } else if(this.Phase == 5) this.Phase = 6;\n    else if(this.Phase == 6) this.Phase = 7;\n    else if(this.Phase == 7) {\n      this.Phase = 8; this.PhaseAt = now; this.Pause = 10;\n    } else if(this.Phase == 8) {\n      flags = TwiBusGetByte(this.Bus);\n      if(flags &amp; 9) this.Pause = 10;\n      else this.Phase = 9;\n    } else if(this.Phase == 9) {\n      rawP = this.Raw20();\n      rawT = this.Raw20();\n      rawH = 0;\n      if(this.Chip == 0x60) {\n        hi = TwiBusGetByte(this.Bus);\n        rawH = (hi &lt;&lt; 8) | TwiBusGetByte(this.Bus);\n      }\n      if(rawT == 0x80000 || rawP == 0x80000 || rawT == 0xFFFFF || rawP == 0xFFFFF || (this.Chip == 0x60 &amp;&amp; rawH == 0x8000)) { this.Fail(-7, now); return; }\n      if(!this.Compensate(rawT, rawP, rawH)) { this.Fail(-7, now); return; }\n      this.Valid = true;\n      this.SetStatus(1);\n      this.Phase = 7; this.At = this.CycleAt; this.Pause = this.Interval;\n    }\n  }\n  Compensate(rawT, rawP, rawH) {\n    let dt = Float(rawT) / 16384 - Float(this.T1) / 1024;\n    let square = Float(rawT) / 131072 - Float(this.T1) / 8192;\n    let fine = dt * this.T2 + square * square * this.T3;\n    let temperature = fine / 5120;\n    fine = Float(Int32(fine));\n    let base = fine / 2 - 64000;\n    let offset = base * base * this.P6 / 32768 + base * this.P5 * 2;\n    offset = offset / 4 + Float(this.P4) * 65536;\n    let scale = (Float(this.P3) * base * base / 524288 + this.P2 * base) / 524288;\n    scale = (1 + scale / 32768) * this.P1;\n    if(scale &lt;= 0) return false;\n    let pressure = (1048576 - Float(rawP) - offset / 4096) * 6250 / scale;\n    pressure = (pressure + (Float(this.P9) * pressure * pressure / 2147483648 + pressure * this.P8 / 32768 + this.P7) / 16) / 100;\n    let humidity = Float(-1);\n    if(this.Chip == 0x60) {\n      let delta = Float(0), curve = Float(0);\n      delta = fine - 76800;\n      curve = 1 + Float(this.H3) * delta / 67108864;\n      humidity = (Float(rawH) - (Float(this.H4) * 64 + Float(this.H5) * delta / 16384)) * (Float(this.H2) / 65536) * (1 + Float(this.H6) * delta * curve / 67108864);\n      humidity = humidity * (1 - Float(this.H1) * humidity / 524288);\n      humidity = Math.min(100, Math.max(0, humidity));\n    }\n    if(!isFinite(temperature) || !isFinite(pressure) || !isFinite(humidity) || temperature &lt; -40 || temperature &gt; 85 || pressure &lt; 300 || pressure &gt; 1100) return false;\n    this.T = temperature; this.P = pressure; this.H = humidity;\n    return true;\n  }\n  Fail(code, now) {\n    this.Valid = false; this.Waiting = false; this.Phase = 0;\n    this.At = now; this.Pause = 1000;\n    this.SetStatus(code);\n  }\n  SetStatus(code) {\n    if(this.Status == code) return;\n    this.Status = code;\n    let stream = code &lt; 0 ? LOG_WARN : LOG_INFO;\n    SendByte(stream, 66) &amp;&amp; SendByte(stream, 77) &amp;&amp; SendByte(stream, 69) &amp;&amp; PrintInt32(stream, 280) &amp;&amp; SendByte(stream, 32) &amp;&amp; PrintInt32(stream, this.Bus) &amp;&amp; SendByte(stream, 47) &amp;&amp; PrintInt32(stream, this.Address) &amp;&amp; SendByte(stream, 58) &amp;&amp; PrintInt32(stream, code);\n    SendByte(stream, 0);\n  }\n}"
	},
	"manifest": { "type": "LPLC/TWI/BME280", "MQTT-SN": { "tag": "---" }, "LPLC": {
	  "pos": { "top": 0, "left": 0 }, "args": { "TwiNr": 0, "Address": 118, "Period": 30000 },
	  "in": {}, "out": { "T": true, "P": true, "H": true, "Valid": true }, "run": {}
	} },
	"mi": { "LPLC": { "mi": {
	  "args": { "mi": {
		"TwiNr": { "cdr": 1, "label": "TWI", "editor": "Integer", "default": 0, "choices": { "provider": "bus", "kind": "twi", "scope": "configured" } },
		"Address": { "cdr": 2, "label": "Address", "editor": "Integer", "format": "0x{0:X2}", "default": 118, "choices": { "provider": "list", "values": [118, 119] } },
		"Period": { "cdr": 3, "label": "Period", "editor": "Integer", "format": "{0} ms", "default": 30000, "choices": { "provider": "list", "values": [1000, 30000, 300000] } }
	  } },
	  "in": { "mi": {} },
	  "out": { "mi": {
		"T": { "default": true, "hint": "Temperature in Celsius" },
		"P": { "default": true, "hint": "Pressure in hPa" },
		"H": { "default": true, "hint": "Relative humidity in percent" },
		"Valid": { "default": true },
		"Status": { "default": true, "hint": "0 initializing; 1 good sample; -1 NACK; -2 TWI timeout; -3 bus/protocol error; -4 unsupported chip ID; -5 invalid calibration; -6 sensor timeout; -7 invalid sample. Errors retry initialization after 1 s" }	  } }
	} } }
  }' />
</xst>
