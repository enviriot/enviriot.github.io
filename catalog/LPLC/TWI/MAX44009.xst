<?xml version='1.0' encoding='utf-8' standalone='yes'?>
<xst path='/$YS/TYPES/LPLC/TWI'>
  <i n='MAX44009' m='{"attr":69}' ver='0.5.2611.04001' s='{
	"hint": "Ambient Light Sensor, 0.045 to 188000 lux",
	"icon": "data:image/svg+xml;base64,",
	"willful": true,
	"LPLC": {
	  "args": ["TwiNr", "Address", "Period"],
	  "in": [],
	  "src": "class MAX44009 {\n  constructor(TwiNr, Address, Period) {\n    this.Bus = TwiNr;\n    this.Address = Address;\n    this.Interval = Int32(Period);\n    this.Lux = new Float(0);\n    this.Valid = false;\n    this.Status = new Int32(0);\n    this.Phase = new Int32(0);\n    this.Waiting = false;\n    this.Count = new Int32(0);\n    this.At = new Int32(0);\n    this.CycleAt = new Int32(0);\n    this.Pause = new Int32(10);\n    this.High = new Int32(0);\n    this.Low = new Int32(0);\n    this.Retry = new Int32(0);\n    this.At = getMilliseconds();\n  }\n  Tick() {\n    let now = getMilliseconds();\n    let status = 0, count = 0, error = -3, i = 0;\n    if(this.Waiting) {\n      status = TwiBusStatus(this.Bus);\n      if(status == 0) { this.Fail(-3, now); return; }\n      if((status &amp; 0xF000) == 0) return;\n      this.Waiting = false;\n      count = (status &gt;&gt;&gt; 24) &amp; 255;\n      if((status &amp; 0xF000) != 0x1000) {\n        if(status &amp; 0x4000) error = -1;\n        else if(status &amp; 0x2000) error = -2;\n        this.Fail(error, now);\n        return;\n      }\n      if((status &amp; 255) != this.Address || count != this.Count) {\n        while(i &lt; count &amp;&amp; i &lt; 32) { TwiBusGetByte(this.Bus); i++; }\n        this.Fail(-3, now);\n        return;\n      }\n      this.Complete(now);\n      return;\n    }\n    if(((now - this.At) | 0) &lt; this.Pause) return;\n    if(TwiBusStatus(this.Bus) != 0) return;\n    if(this.Phase == 0) {\n      // Configuration 0: automatic mode, a measurement every 800 ms with the range chosen by the sensor\n      this.Count = 0;\n      TwiBusControl(this.Bus, this.Address | 0x00020100);\n      TwiBusPutByte(this.Bus, 2);\n      TwiBusPutByte(this.Bus, 0);\n      this.Waiting = true;\n    } else if(this.Phase == 1) this.ReadRegister(2);\n    else if(this.Phase == 2) { this.CycleAt = now; this.ReadRegister(3); }\n    else if(this.Phase == 3) this.ReadRegister(4);\n    else if(this.Phase == 4) this.ReadRegister(3);\n  }\n  ReadRegister(reg) {\n    this.Count = 1;\n    TwiBusControl(this.Bus, this.Address | 0x01010300);\n    TwiBusPutByte(this.Bus, reg);\n    this.Waiting = true;\n  }\n  Complete(now) {\n    let high = 0, exponent = 0, mantissa = 0;\n    this.At = now;\n    this.Pause = 0;\n    if(this.Phase == 0) this.Phase = 1;\n    else if(this.Phase == 1) {\n      // No ID register: the readback of CONT and MANUAL tells it is the sensor and it took the mode\n      if((TwiBusGetByte(this.Bus) &amp; 0xC0) != 0) { this.Fail(-5, now); return; }\n      this.Phase = 2;\n      this.Pause = 800;\n    } else if(this.Phase == 2) {\n      this.High = TwiBusGetByte(this.Bus);\n      this.Retry = 0;\n      this.Phase = 3;\n    } else if(this.Phase == 3) {\n      this.Low = TwiBusGetByte(this.Bus);\n      this.Phase = 4;\n    } else if(this.Phase == 4) {\n      // The datasheet reads 0x03 and 0x04 with a repeated START, one transfer here is one register: the high\n      // byte once more, changed - a new measurement came between, the low byte may be of the other one\n      high = TwiBusGetByte(this.Bus);\n      if(high != this.High) {\n        this.Retry++;\n        if(this.Retry &gt; 3) { this.Fail(-7, now); return; }\n        this.High = high;\n        this.Phase = 3;\n        return;\n      }\n      exponent = high &gt;&gt; 4;\n      if(exponent == 15) { this.Fail(-7, now); return; }\n      mantissa = ((high &amp; 15) &lt;&lt; 4) | (this.Low &amp; 15);\n      while(exponent &gt; 0) { mantissa = mantissa * 2; exponent--; }     // The compiler shifts by constants only\n      this.Lux = Float(mantissa) * 0.045;\n      this.Valid = true;\n      this.SetStatus(1);\n      this.Phase = 2;\n      this.Pause = this.Interval - ((now - this.CycleAt) | 0);\n      if(this.Pause &lt; 0) this.Pause = 0;\n    }\n  }\n  Fail(code, now) {\n    this.Valid = false;\n    this.Waiting = false;\n    this.Phase = 0;\n    this.At = now;\n    this.Pause = 1000;\n    this.SetStatus(code);\n  }\n  SetStatus(code) {\n    if(this.Status == code) return;\n    this.Status = code;\n    let stream = LOG_INFO;\n    if(code &lt; 0) stream = LOG_WARN;\n    PrintF(stream, \"MAX44009 %d/%d:%d\\x00\", this.Bus, this.Address, code);\n  }\n}"
	},
	"manifest": { "type": "LPLC/TWI/MAX44009", "MQTT-SN": { "tag": "---" }, "LPLC": {
	  "pos": { "top": 0, "left": 0 }, "args": { "TwiNr": 0, "Address": 74, "Period": 30000 },
	  "in": {}, "out": { "Lux": true, "Valid": true }, "run": {}
	} },
	"mi": { "LPLC": { "mi": {
	  "args": { "mi": {
		"TwiNr": { "cdr": 1, "label": "TWI", "editor": "Integer", "default": 0, "choices": { "provider": "bus", "kind": "twi", "scope": "configured" } },
		"Address": { "cdr": 2, "label": "Address", "editor": "Integer", "format": "0x{0:X2}", "default": 74, "choices": { "provider": "list", "values": [74, 75] } },
		"Period": { "cdr": 3, "label": "Period", "editor": "Integer", "format": "{0} ms", "default": 30000, "choices": { "provider": "list", "values": [1000, 30000, 300000] } }
	  } },
	  "in": { "mi": {} },
	  "out": { "mi": {
		"Lux": { "default": true, "hint": "Illuminance in lux, 0.045 to 188000; the sensor measures every 800 ms" },
		"Valid": { "default": true, "hint": "False at startup and after an error; true after a good sample, retained while measuring" },
		"Status": { "default": true, "hint": "0 initializing; 1 good sample; -1 NACK; -2 TWI timeout; -3 bus/protocol error; -5 configuration mismatch; -7 overrange or a reading that kept changing. Errors retry initialization after 1 s" }
	  } }
	} } }
  }' />
</xst>
