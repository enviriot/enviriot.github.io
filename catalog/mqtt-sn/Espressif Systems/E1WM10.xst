          "modes": {
            "UART0_RX": { "v": 21, "hint": "UART0 RX", "opt": { "hint": "frame format", "default": 0, "values": { "8N1": 0, "8E1": 1, "8O1": 2, "8N2": 4, "8E2": 5, "8O2": 6 } } },
