            "UART1_DE": { "v": 25, "hint": "UART1 RS-485 driver enable" },
            "UART2_TX": { "v": 26, "hint": "UART2 TX", "opt": { "hint": "baud rate", "min": 1, "max": 5000000, "default": 9600 } },
