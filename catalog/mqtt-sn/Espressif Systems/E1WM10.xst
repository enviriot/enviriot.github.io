            "IN_PD":     { "v": 3, "io": "in", "hint": "Digital input, pull-down",
                           "opt": { "hint": "debounce, ms", "min": 0, "max": 60000, "default": 0 } },
            "IN_INV_PU": { "v": 4, "io": "in", "hint": "Inverted input, pull-up: a contact to ground reads 1",
                           "opt": { "hint": "debounce, ms", "min": 0, "max": 60000, "default": 0 } }
          },
          "pins": [0, 1, 2, 3, 4, 5, 12, 13, 14, 15, 16, 17, 18, 19, 21, 22, 23, 25, 26, 27, 32, 33]
        },
        "Outputs": {
          "modes": {
            "OUT":        { "v": 5, "io": "out", "hint": "Digital output" },
            "OUT_INV":    { "v": 6, "io": "out", "hint": "Inverted output: 1 drives the pin low" },
            "OUT_OD":     { "v": 7, "io": "out", "hint": "Open drain output" },
            "OUT_OD_INV": { "v": 8, "io": "out", "hint": "Inverted open drain output" },
            "PWM":        { "v": 11, "io": "out", "hint": "PWM, duty 0..65535",
                            "opt": { "hint": "frequency, Hz", "min": 1, "max": 40000000, "default": 1000 } },
            "PWM_INV":    { "v": 12, "io": "out", "hint": "Inverted PWM, duty 0..65535",
                            "opt": { "hint": "frequency, Hz", "min": 1, "max": 40000000, "default": 1000 } }
          },
          "pins": [0, 1, 2, 3, 4, 5, 12, 13, 14, 15, 16, 17, 18, 19, 21, 22, 23, 25, 26, 27, 32, 33]
        },
        "Counters": {
          "modes": {
            "CNT_RISE": { "v": 13, "io": "io", "hint": "Pulse counter, rising edges; writing sets the count",
                          "opt": { "hint": "filter, ns", "min": 0, "max": 12700, "default": 0 } },
            "CNT_FALL": { "v": 14, "io": "io", "hint": "Pulse counter, falling edges; writing sets the count",
                          "opt": { "hint": "filter, ns", "min": 0, "max": 12700, "default": 0 } },
            "CNT_BOTH": { "v": 15, "io": "io", "hint": "Pulse counter, both edges; writing sets the count",
                          "opt": { "hint": "filter, ns", "min": 0, "max": 12700, "default": 0 } }
          },
          "pins": [0, 1, 2, 3, 4, 5, 12, 13, 14, 15, 16, 17, 18, 19, 21, 22, 23, 25, 26, 27, 32, 33, 34, 35, 36, 37, 38, 39]
        },
        "ADC1": {
          "modes": {
            "ANALOG": { "v": 9, "io": "in", "hint": "Analog input, mV",
