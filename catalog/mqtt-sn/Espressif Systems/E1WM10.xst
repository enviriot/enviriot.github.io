                                             "6 dB, 150-1750 mV": 2, "12 dB, 150-2450 mV": 3 } } }
          },
          "pins": [32, 33, 34, 35, 36, 37, 38, 39]
        },
        "DAC": {
          "modes": {
            "DAC": { "v": 10, "io": "out", "hint": "Analog output 0..255" }
