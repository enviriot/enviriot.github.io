<xst path='/$YS/TYPES/LoBlock/Common' m='{"attr":65}'>
  <i n='Decoder' s='{"Logram":{"block":"Common/Decoder"},"Children":{"IN":{"ddr":-1,"default":0,"manifest":{"attr":69},"rc":"X1"},"CE":{"ddr":-2,"default":false,"manifest":{"attr":68},"rc":"X2"},"Q0":{"ddr":1,"default":false,"manifest":{"attr":65},"rc":"X11"},"Q1":{"ddr":2,"default":false,"manifest":{"attr":65},"rc":"X12"},"Q2":{"ddr":3,"default":false,"manifest":{"attr":64},"rc":"X13"},"Q3":{"ddr":4,"default":false,"manifest":{"attr":64},"rc":"X14"},"Q4":{"ddr":5,"default":false,"manifest":{"attr":64},"rc":"X15"},"Q5":{"ddr":6,"default":false,"manifest":{"attr":64},"rc":"X16"},"Q6":{"ddr":7,"default":false,"manifest":{"attr":64},"rc":"X17"},"Q7":{"ddr":8,"default":false,"manifest":{"attr":64},"rc":"X18"}},"default":"","hint":"1 of N decoder","icon":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsMAAA7DAcdvqGQAAABaSURBVDhPtZBRCgAhCAU9ujd3sa8Yk3jVBiMhOloWEXZDTZhlWMLaVrA6mXf3cT0WEFmQGxBJQN5sQOtOUAZmgJG943DIuycoAvLfBh3tJxJOmWFtaVYpCZUPw8yzG080lrgAAAAASUVORK5CYII=","manifest":{"attr":66,"type":"LoBlock/Common/Decoder"},"namePrefix":"A","src":"class Decoder{\r\n  constructor(){\r\n    this.outputs=[\"Q0\", \"Q1\", \"Q2\", \"Q3\", \"Q4\", \"Q5\", \"Q6\", \"Q7\"];\r\n    // пины могут быть ещё не созданы к моменту вызова конструктора\r\n    setTimeout(this.Update.bind(this), 16);\r\n  }\r\n  Calculate(pin){\r\n    this.Update();\r\n  }\r\n  Update(){\r\n    // отсутствующий CE означает \"разрешено\", созданный - своё значение\r\n    let ce = this.GetState(\"CE\");\r\n    let sel = -1;\r\n    if(typeof(ce)==\"undefined\" || ce){\r\n      let v = +this.GetState(\"IN\");\r\n      if(!isNaN(v)){\r\n        sel = Math.floor(v);\r\n      }\r\n    }\r\n    let i;\r\n    for(i=0; i&lt;this.outputs.length; i++){\r\n      // несозданный выход не трогаем: SetState создал бы топик\r\n      if(typeof(this.GetState(this.outputs[i]))==\"undefined\"){\r\n        continue;\r\n      }\r\n      this.SetState(this.outputs[i], i===sel);\r\n    }\r\n  }\r\n}","willful":true}' m='{"attr":69,"type":"Ext/LBDescr"}' ver='0.5.2609.11001' />
</xst>