  <i n='refos_em06t' s='{"cctor":{"LoBlock":"IOT/refos_em06t"},"Children":{"In":{"ddr":-1,"default":false,"manifest":{"attr":69},"rc":"X2"},"ip":{"default":"192.168.102.1","manifest":{"attr":69,"editor":"String"},"rc":"X3"},"online":{"ddr":1,"manifest":{"attr":65},"rc":"X4"},"Q":{"ddr":2,"manifest":{"attr":65},"rc":"X1"}},"hint":"Refoss Smart Energy Monitor","icon":"data:image/png;base64,","manifest":{"attr":66,"type":"LoBlock/IOT/refos_em06t"},"namePrefix":"A","src":"class OpenMeteo{\r\n  constructor(){\r\n    this.timer = setTimeout(this.Tick.bind(this), (1+Math.random())*250);\r\n  }\r\n  Calculate(pin){\r\n    if(pin==&apos;In&apos; &amp;&amp; this.GetState(&apos;In&apos;)){\r\n      if(this.timer){\r\n        clearTimeout(this.timer);\r\n      }\r\n      this.timer = setTimeout(this.Tick.bind(this), 30);\r\n    }\r\n  }\r\n  Tick(){\r\n    let ip = this.GetState(&apos;ip&apos;);\r\n    if(!ip || typeof(ip) !== &apos;string&apos;) return;\r\n    this.timer = setTimeout(this.Tick.bind(this), 1750+Math.random()*500);\r\n    \r\n    this.xhr = new XMLHttpRequest();\r\n    let req = &apos;http://&apos; + ip + &apos;/rpc/Refoss.Status.Get&apos;;\r\n    this.xhr.open(&apos;GET&apos;, req);\r\n    this.xhr.onreadystatechange =  this.response.bind(this);\r\n    this.xhr.send();\r\n    console.debug(\"RE: \" + req);\r\n  }\r\n  response(){\r\n    let online = this.GetState(&apos;online&apos;);\r\n    console.debug(\"RE: \" + this.xhr.status.toString());\r\n    if(this.xhr.readyState ==  4) {\r\n      if(this.xhr.status == 200) {\r\n        try{\r\n          let wf = JSON.parse(this.xhr.responseText);\r\n          this.SetState(&apos;Q&apos;, wf);\r\n          online = true;\r\n        } catch(e){\r\n          console.warn(&apos;Refos - &apos; + e);\r\n          online = false;\r\n        }\r\n      } else {\r\n        console.warn(&apos;Refos.response - state: &apos; + this.xhr.readyState + &apos;, status: &apos; + this.xhr.status);\r\n        online = false;\r\n      }\r\n    }\r\n    this.SetState(\"online\", online);\r\n  }\r\n}","willful":true}' m='{"attr":69,"type":"Ext/LBDescr"}' ver='0.4.2606.27384' />
